{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(detect-secrets scan:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pre-commit run:*)",
      "Read(**/**)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoRead",
      "TaskList",
      "TaskGet",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(git --no-pager status:*)",
      "Bash(git --no-pager rev-parse:*)",
      "Bash(git --no-pager rev-list:*)",
      "Bash(git --no-pager log:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git --no-pager blame:*)",
      "Bash(find:*)",
      "Bash(shasum:*)",
      "Bash(sha256sum:*)",
      "Bash(date:*)",
      "Bash(rg:*)",
      "Bash(npx prettier:*)",
      "Bash(rm -f openwiki/_plan.md)",
      "Edit(openwiki/**)",
      "Edit(CLAUDE.md)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5",
  "fallbackModel": [
    "claude-sonnet-5"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(?!AskUserQuestion$|ExitPlanMode$|EnterPlanMode$).*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash /Users/jeremy/.claude/hooks/session-allow.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$OPENWIKI_HOOK\" ] || OPENWIKI_HOOK=1 nohup /Users/jeremy/.claude/hooks/wiki-sync.sh >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/ccline/ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "cli-tools@equativ-plugins": true,
    "cc-skills-golang@samber": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "ansible-skills@ansible-skills-marketplace": true,
    "openwiki@openwiki-cc": true
  },
  "extraKnownMarketplaces": {
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "ansible-skills-marketplace": {
      "source": {
        "source": "github",
        "repo": "sigridjineth/hello-ansible-skills"
      }
    },
    "openwiki-cc": {
      "source": {
        "source": "github",
        "repo": "SoulKyu/openwiki-cc"
      }
    }
  },
  "effortLevel": "high",
  "companyAnnouncements": [
    "Coucou Jerem pense à déconnecter"
  ],
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoUpdatesChannel": "latest",
  "outputStyle": "Concise"
}
