extract () {
	if [ -f "$1" ]; then
		case "$1" in
			(*.7z) 7z x "$1" ;;
			(*.lzma) unlzma "$1" ;;
			(*.rar) unrar x "$1" ;;
			(*.tar) tar xvf "$1" ;;
			(*.tar.bz2) tar xvjf "$1" ;;
			(*.bz2) bunzip2 "$1" ;;
			(*.tar.gz) tar xvzf "$1" ;;
			(*.gz) gunzip "$1" ;;
			(*.tar.xz) tar Jxvf "$1" ;;
			(*.xz) xz -d "$1" ;;
			(*.tbz2) tar xvjf "$1" ;;
			(*.tgz) tar xvzf "$1" ;;
			(*.zip) unzip "$1" ;;
			(*.Z) uncompress ;;
			(*) echo "don't know how to extract '$1'..." ;;
		esac
	else
		echo "Error: '$1' is not a valid file!"
		exit 0
	fi
}

kevents() {
{
	echo $'TIME\tNAMESPACE\tTYPE\tREASON\tOBJECT\tSOURCE\tMESSAGE';
	kubectl get events -o json "$@" \
		| jq -r  '.items | map(. + {t: (.eventTime//.lastTimestamp)}) | sort_by(.t)[] | [.t, .metadata.namespace, .type, .reason, .involvedObject.kind + "/" + .involvedObject.name, .source.component + "," + (.source.host//"-"), .message] | @tsv';
	} \
		| column -s $'\t' -t \
		| less -S
}

# Switch context, preserve current namespace
kcx() {
    local current_ns
    current_ns=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}')
    [[ -z "$current_ns" ]] && current_ns="default"

    switch "$@"

    kubectl config set-context --current --namespace="$current_ns" > /dev/null
    echo "namespace: $current_ns"
}

# Switch context AND namespace in one go
# Usage: kswitch [<context> [namespace]]   (no args → list contexts)
kswitch() {
    if [[ $# -eq 0 ]]; then
        switcher alias ls
        return
    fi

    local ctx="$1"
    local ns="${2:-default}"

    switch "$ctx" && switch ns "$ns"
}

# Completion for kswitch/kcx: arg1 = context (from `switcher alias ls`), arg2 = namespace
_kswitch() {
    local state
    _arguments \
        '1:context:->contexts' \
        '2:namespace:->namespaces'

    case $state in
        contexts)
            local -a contexts
            contexts=(${(f)"$(switcher alias ls 2>/dev/null | awk -F'|' '/^\|/ && !/ALIAS/ && !/TOTAL/ { gsub(/^ +| +$/, "", $2); if ($2 != "") print $2 }')"})
            _describe 'switcher alias' contexts
            ;;
        namespaces)
            local -a namespaces
            namespaces=(${(f)"$(kubectl get namespaces --no-headers -o custom-columns=':metadata.name' 2>/dev/null)"})
            _describe 'namespace' namespaces
            ;;
    esac
}
compdef _kswitch kswitch
compdef _kswitch kcx      # kcx switches context only → reuse the context completion

# Alias generators for k8s context/namespace shortcuts (data lives in ~/.zsh_work):
#   _kns  <alias> <namespace>            → switch ns <namespace>
#   _kctx <alias> <context> <namespace>  → switch <context> && switch ns <namespace>
_kns()  { alias "$1"="switch ns $2"; }
_kctx() { alias "$1"="switch $2 && switch ns $3"; }

mergebranch() {
	local BRANCH=$(git rev-parse --abbrev-ref HEAD)
	glab mr approve $BRANCH
    glab mr merge --rebase --remove-source-branch --yes $BRANCH
}

source <(switcher init zsh)
source <(alias s=switch)
source <(compdef _switcher switch)
eval "$(gopen --completion=zsh)"
